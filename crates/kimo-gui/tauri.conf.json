{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimo Spectator",
  "version": "5.0.1",
  "identifier": "dev.kimo.spectator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Kimo \u00b7 spectator",
        "width": 1376,
        "height": 768,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "label": "main",
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Read-only live view of a kimo engine session",
    "longDescription": "Kimo Spectator listens on 127.0.0.1:7421 for the kimo-mcp telemetry stream and shows each MCP tool call, the timeline and the auto-rendered preview frame. It is read-only: it never calls the engine.",
    "publisher": "naman-sharma12345",
    "copyright": "Copyright (c) 2026 naman-sharma12345",
    "license": "MIT",
    "homepage": "https://getkimo.tech",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
