{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main kimo window: listens to engine/agent events (and file drops) and calls the app's own commands (each named below). No shell, no filesystem, no HTTP from the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible",
    "allow-app-state",
    "allow-engine-restart",
    "allow-engine-call",
    "allow-engine-read",
    "allow-changes-list",
    "allow-change-undo",
    "allow-project-open",
    "allow-project-save",
    "allow-project-new",
    "allow-pick",
    "allow-media-thumb",
    "allow-open-url",
    "allow-reveal",
    "allow-cli-status",
    "allow-cli-signin",
    "allow-cli-install",
    "allow-cli-register",
    "allow-cli-models",
    "allow-agent-select",
    "allow-agent-send",
    "allow-agent-stop",
    "allow-agent-reset",
    "allow-mcp-set",
    "allow-mcp-probe",
    "allow-key-set",
    "allow-key-clear",
    "allow-key-test",
    "allow-settings-set",
    "allow-onboarded-set",
    "allow-recovery-status",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-open-spectator",
    "allow-setup-status",
    "allow-setup-start",
    "allow-setup-pause",
    "allow-setup-skip",
    "allow-viewer-frame",
    "allow-viewer-draft"
  ]
}
