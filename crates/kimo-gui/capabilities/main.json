{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main kimo window: listens to engine/agent events and calls the app's own commands (each named below). No shell, no filesystem, no HTTP from the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible",
    "allow-app-state",
    "allow-engine-restart",
    "allow-mcp-set",
    "allow-mcp-probe",
    "allow-agents-detect",
    "allow-agent-add",
    "allow-key-set",
    "allow-key-clear",
    "allow-key-test",
    "allow-settings-set",
    "allow-chat-send",
    "allow-chat-undo",
    "allow-chat-reset",
    "allow-project-open",
    "allow-open-spectator",
    "allow-setup-status",
    "allow-setup-start",
    "allow-setup-pause",
    "allow-setup-skip",
    "allow-viewer-frame",
    "allow-viewer-draft"
  ]
}
